# JorsenShop V2 (Vercel + Neon, development branch)
# These are PLACEHOLDERS only. Configure values in Vercel Settings -> Environment Variables.
# Never commit real tokens or PostgreSQL connection strings.
DATABASE_URL=replace-with-neon-database-url-for-this-environment
NEON_AUTH_BASE_URL=replace-with-neon-auth-url-ending-in-auth
CLOUDINARY_CLOUD_NAME=replace-with-dedicated-jorsenshop-cloud
CLOUDINARY_API_KEY=replace-with-secret-configured-only-on-the-server
CLOUDINARY_API_SECRET=replace-with-secret-configured-only-on-the-server
SESSION_SECRET=replace-with-generated-32-plus-character-random-value

# Production environment must use production Neon DB and Auth branch only AFTER audit.
# Preview environment must use the isolated JorsenShop V2 development Neon branch.
# The frontend never receives DATABASE_URL, CLOUDINARY_API_SECRET, or SESSION_SECRET.
